{
  "name": "cozinha-pedidos-api",
  "version": "1.0.0",
  "description": "API REST para controle de pedidos de uma cozinha de comida saudável, com a suíte de testes de API no mesmo repositório",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "seed": "tsx --env-file=.env prisma/seedUsuario.ts",
    "lint": "eslint src",
    "test": "mocha --reporter mochawesome"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.15",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "mocha": "^11.8.0",
    "mochawesome": "^8.0.1",
    "prisma": "^5.19.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
